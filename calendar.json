layout: null
permalink: /calendar.json
---
{% assign records = site.posts | concat: site.essays | sort: 'date' | reverse %}[
{% for entry in records %}{"date":{{ entry.date | date: '%Y-%m-%d' | jsonify }},"url":{{ entry.url | relative_url | jsonify }},"title":{{ entry.title | jsonify }}}{% unless forloop.last %},{% endunless %}
{% endfor %}]
