---
layout: null
permalink: /feed.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="{{ '/xml-view.xsl' | relative_url }}"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom" xmlns:content="http://purl.org/rss/1.0/modules/content/">
  <channel>
    <title>{{ site.title | xml_escape }}</title>
    <description>{{ site.description | xml_escape }}</description>
    <link>{{ '/' | absolute_url | xml_escape }}</link>
    <language>zh-CN</language>
    <ttl>60</ttl>
    <atom:link href="{{ "/feed.xml" | prepend: site.baseurl | prepend: site.url }}" rel="self" type="application/rss+xml" />
    <lastBuildDate>{{ site.time | date_to_rfc822 }}</lastBuildDate>
    <generator>Jekyll v{{ jekyll.version }}</generator>
    {% assign feed_entries = site.posts | concat: site.essays | concat: site.learning | sort: 'date' | reverse %}
    {% assign emitted = 0 %}
    {% for post in feed_entries %}
      {% if post.published == false or post.feed == false %}{% continue %}{% endif %}
      {% assign body_text = post.content | strip_html | strip %}
      {% if post.source == 'qzone' and body_text.size < 120 %}{% continue %}{% endif %}
      {% if emitted >= 50 %}{% break %}{% endif %}
      {% assign emitted = emitted | plus: 1 %}
      <item>
        <title>{{ post.title | xml_escape }}</title>
        <description>{{ post.description | default: body_text | truncate: 320 | xml_escape }}</description>
        {% assign rendered_body = post.content | markdownify %}
        {% assign root_href = 'href="' | append: site.url | append: '/' %}
        {% assign root_src = 'src="' | append: site.url | append: '/' %}
        <content:encoded>{{ rendered_body | replace: 'href="/', root_href | replace: 'src="/', root_src | xml_escape }}</content:encoded>
        {% assign published_date = post.added | default: post.date %}
        <pubDate>{{ published_date | date_to_rfc822 }}</pubDate>
        <link>{{ post.url | absolute_url | xml_escape }}</link>
        <guid isPermaLink="true">{{ post.url | absolute_url | xml_escape }}</guid>
        {% for tag in post.tags %}
        <category>{{ tag | xml_escape }}</category>
        {% endfor %}
        {% for cat in post.categories %}
        <category>{{ cat | xml_escape }}</category>
        {% endfor %}
      </item>
    {% endfor %}
  </channel>
</rss>
